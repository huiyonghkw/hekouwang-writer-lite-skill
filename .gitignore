# 本地学习日志默认入库（自进化靠 git 历史追溯）；不想公开的敏感条目请在提交前删除
*.log
__pycache__/
.DS_Store

# 付费包资产与内部计划：只存本地，绝不进公开仓库
edition/
roadmap/
archive/
dist/

# SkillHub 402 服务端与客户端：独立私有仓，主仓忽略
services/

# 遗留 worktree（旧 product 分支），非标准发布方式；见 STRUCTURE.md 迁移说明
public/

# Agent 本地配置（权限、会话设置），只存本机
.qwen/

# 本地工具缓存（浏览器/调试），不进仓库
.gstack/

# 渠道发布草稿与回执（materials/publish/channel/<渠道>/）：含编辑摘要、
# 联系方式与发布记录，只存本地。
# 只忽略 publish/，不忽略整个 materials/：根下的 icon-skillhub-* 与
# writer-skill-overview.png 是公开素材，要跟着仓库走。
materials/publish/

# 环境变量：只提交模板，不提交真实值
.env
.env.*
!.env.example
